{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "Rabbittize AWS One-Click Integration - Standard permissions for cloud cost, health, and AI observability.",
    "Parameters": {
        "RabbittizeWorkspaceID": {
            "Description": "The Rabbittize Workspace ID to sync your account. Do not change this value.",
            "MinLength": "1",
            "Type": "String",
            "Default": "REPLACE_WITH_RABBITTIZE_WORKSPACE_ID"
        },
        "RabbittizeExternalID": {
            "Description": "The Rabbittize external ID for secure cross-account authentication. Do not change this value.",
            "MinLength": "1",
            "Type": "String",
            "Default": "REPLACE_WITH_RABBITTIZE_EXTERNAL_ID"
        },
        "RabbittizeTrustRoleArn": {
            "Description": "The Rabbittize IAM role that is permitted to assume the created role.",
            "MinLength": "1",
            "Type": "String",
            "Default": "767397861361"
        },
        "RabbittizePingbackArn": {
            "Description": "The ARN of the Rabbittize webhook to notify upon successful stack creation.",
            "MinLength": "1",
            "Type": "String",
            "Default": "arn:aws:sns:us-east-1:767397861361:rabbittize-customer-pingbacks"
        },
        "RabbittizeDomain": {
            "Description": "The Rabbittize domain identifier.",
            "MinLength": "1",
            "Type": "String",
            "Default": "rabbittize.com"
        },
        "RabbittizeNotificationTopicArn": {
            "Description": "Optional: SNS Topic ARN for S3 bucket notifications.",
            "Type": "String",
            "Default": ""
        },
        "ReportName": {
            "Description": "The name of the Cost and Usage Report.",
            "MinLength": "1",
            "Type": "String",
            "Default": "RabbittizeCostReport"
        },
        "BucketName": {
            "Description": "The name of the S3 bucket where CUR will be stored. Must be globally unique.",
            "MinLength": "1",
            "Type": "String"
        },
        "TimeUnit": {
            "Description": "Aggregation granularity for the Cost and Usage Report.",
            "Type": "String",
            "AllowedValues": [
                "HOURLY",
                "DAILY"
            ],
            "Default": "DAILY"
        },
        "EnableAiObservability": {
            "Description": "Enable AI Observability module — grants read-only access to Bedrock, AI-related CloudWatch metrics, and Cost Explorer AI filters.",
            "Type": "String",
            "AllowedValues": ["true", "false"],
            "Default": "true"
        },
        "EnableLogForwarding": {
            "Description": "Enable advanced log forwarding — deploys a Lambda function that forwards AI application logs to Rabbittize for richer trace analysis.",
            "Type": "String",
            "AllowedValues": ["true", "false"],
            "Default": "false"
        },
        "RabbittizeWebhookUrl": {
            "Description": "The Rabbittize HTTPS webhook endpoint for log forwarding. Required only if EnableLogForwarding is true.",
            "Type": "String",
            "Default": ""
        }
    },
    "Mappings": {
        "TimeUnitMap": {
            "DAILY": {
                "S3Prefix": "daily-v1"
            },
            "HOURLY": {
                "S3Prefix": "hourly-v1"
            }
        }
    },
    "Conditions": {
        "HasNotificationTopic": {
            "Fn::Not": [
                {
                    "Fn::Equals": [
                        { "Ref": "RabbittizeNotificationTopicArn" },
                        ""
                    ]
                }
            ]
        },
        "AiObservabilityEnabled": {
            "Fn::Equals": [ { "Ref": "EnableAiObservability" }, "true" ]
        },
        "LogForwardingEnabled": {
            "Fn::And": [
                { "Fn::Equals": [ { "Ref": "EnableLogForwarding" }, "true" ] },
                { "Fn::Not": [ { "Fn::Equals": [ { "Ref": "RabbittizeWebhookUrl" }, "" ] } ] }
            ]
        }
    },
    "Resources": {
        "CrossAccountRole": {
            "Type": "AWS::IAM::Role",
            "Properties": {
                "RoleName": "RabbittizeCrossAccountRole",
                "AssumeRolePolicyDocument": {
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "AWS": {
                                    "Ref": "RabbittizeTrustRoleArn"
                                }
                            },
                            "Action": [
                                "sts:AssumeRole"
                            ],
                            "Condition": {
                                "StringEquals": {
                                    "sts:ExternalId": {
                                        "Ref": "RabbittizeExternalID"
                                    }
                                }
                            }
                        }
                    ]
                },
                "ManagedPolicyArns": [
                    "arn:aws:iam::aws:policy/job-function/ViewOnlyAccess"
                ],
                "Path": "/",
                "Policies": [
                    {
                        "PolicyName": "RabbittizeBillingReadOnly",
                        "PolicyDocument": {
                            "Version": "2012-10-17",
                            "Statement": [
                                {
                                    "Sid": "BillingAccess",
                                    "Effect": "Allow",
                                    "Action": [
                                        "aws-portal:ViewBilling",
                                        "aws-portal:ViewUsage",
                                        "budgets:Describe*",
                                        "budgets:View*",
                                        "ce:Get*",
                                        "ce:Describe*",
                                        "ce:List*",
                                        "cur:Describe*",
                                        "pricing:*",
                                        "organizations:Describe*",
                                        "organizations:List*",
                                        "savingsplans:Describe*"
                                    ],
                                    "Resource": "*"
                                }
                            ]
                        }
                    },
                    {
                        "PolicyName": "RabbittizeOptimizationAccess",
                        "PolicyDocument": {
                            "Version": "2012-10-17",
                            "Statement": [
                                {
                                    "Sid": "OptimizationActions",
                                    "Effect": "Allow",
                                    "Action": [
                                        "ec2:AcceptReservedInstancesExchangeQuote",
                                        "ec2:CancelReservedInstancesListing",
                                        "ec2:CreateReservedInstancesListing",
                                        "ec2:DeleteQueuedReservedInstances",
                                        "ec2:CreateTags",
                                        "ec2:ModifyReservedInstances",
                                        "ec2:PurchaseReservedInstancesOffering",
                                        "rds:PurchaseReservedDBInstancesOffering",
                                        "elasticache:PurchaseReservedCacheNodesOffering",
                                        "es:PurchaseReservedInstanceOffering",
                                        "redshift:PurchaseReservedNodeOffering",
                                        "redshift:AcceptReservedNodeExchange",
                                        "redshift:GetReservedNodeExchangeConfigurationOptions",
                                        "redshift:GetReservedNodeExchangeOfferings",
                                        "savingsplans:*",
                                        "servicequotas:Get*",
                                        "servicequotas:List*",
                                        "servicequotas:RequestServiceQuotaIncrease",
                                        "support:*",
                                        "ce:StartSavingsPlansPurchaseRecommendationGeneration"
                                    ],
                                    "Resource": "*"
                                },
                                {
                                    "Sid": "OptimizationRuntimeExecutionActions",
                                    "Effect": "Allow",
                                    "Action": [
                                        "autoscaling:UpdateAutoScalingGroup",
                                        "application-autoscaling:RegisterScalableTarget",
                                        "application-autoscaling:PutScalingPolicy",
                                        "ec2:StopInstances",
                                        "ec2:StartInstances",
                                        "ec2:TerminateInstances",
                                        "ec2:ModifyInstanceAttribute",
                                        "ec2:CreateSnapshot",
                                        "ec2:DeleteVolume",
                                        "ec2:CreateImage",
                                        "ec2:RunInstances",
                                        "ec2:DeregisterImage",
                                        "ec2:DeleteSnapshot",
                                        "ec2:AssociateAddress",
                                        "ec2:DisassociateAddress",
                                        "route53:ChangeResourceRecordSets",
                                        "route53:GetHostedZone",
                                        "route53:ListResourceRecordSets",
                                        "rds:StopDBInstance",
                                        "rds:StartDBInstance",
                                        "rds:ModifyDBInstance",
                                        "rds:CreateDBSnapshot",
                                        "rds:DeleteDBSnapshot",
                                        "lambda:UpdateFunctionConfiguration",
                                        "lambda:GetFunction",
                                        "lambda:UpdateFunctionCode",
                                        "s3:PutLifecycleConfiguration",
                                        "s3:GetLifecycleConfiguration",
                                        "s3:DeleteBucket",
                                        "s3:ListBucket",
                                        "s3:ListBucketVersions",
                                        "s3:DeleteObject",
                                        "s3:DeleteObjectVersion",
                                        "ecs:UpdateService"
                                    ],
                                    "Resource": "*"
                                }
                            ]
                        }
                    },
                    {
                        "PolicyName": "RabbittizeCloudWatchMetricsReadOnly",
                        "PolicyDocument": {
                            "Version": "2012-10-17",
                            "Statement": [
                                {
                                    "Sid": "ContainerInsightsReadOnly",
                                    "Effect": "Allow",
                                    "Action": [
                                        "logs:List*",
                                        "logs:Describe*",
                                        "logs:StartQuery",
                                        "logs:StopQuery",
                                        "logs:Filter*",
                                        "logs:Get*"
                                    ],
                                    "Resource": "arn:aws:logs:*:*:log-group:/aws/containerinsights/*"
                                },
                                {
                                    "Sid": "ContainerInsightsLogStream",
                                    "Effect": "Allow",
                                    "Action": [
                                        "logs:GetQueryResults",
                                        "logs:DescribeLogGroups"
                                    ],
                                    "Resource": "arn:aws:logs:*:*:log-group::log-stream:*"
                                },
                                {
                                    "Sid": "ContainerMetricsAccess",
                                    "Effect": "Allow",
                                    "Action": [
                                        "autoscaling:Describe*",
                                        "cloudwatch:Describe*",
                                        "cloudwatch:Get*",
                                        "cloudwatch:List*",
                                        "cloudwatch:PutMetricAlarm",
                                        "cloudwatch:DeleteAlarms",
                                        "cloudwatch:EnableAlarmActions",
                                        "cloudwatch:DisableAlarmActions"
                                    ],
                                    "Resource": "*"
                                }
                            ]
                        }
                    },
