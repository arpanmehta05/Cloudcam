                    {
                        "Fn::If": [
                            "AiObservabilityEnabled",
                            {
                                "PolicyName": "RabbittizeAiObservabilityReadOnly",
                                "PolicyDocument": {
                                    "Version": "2012-10-17",
                                    "Statement": [
                                        {
                                            "Sid": "BedrockReadOnly",
                                            "Effect": "Allow",
                                            "Action": [
                                                "bedrock:ListFoundationModels",
                                                "bedrock:GetFoundationModel",
                                                "bedrock:ListModelInvocationLoggingConfigurations",
                                                "bedrock:GetModelInvocationLoggingConfiguration",
                                                "bedrock:ListProvisionedModelThroughputs",
                                                "bedrock:GetProvisionedModelThroughput"
                                            ],
                                            "Resource": "*"
                                        },
                                        {
                                            "Sid": "AiCloudWatchAccess",
                                            "Effect": "Allow",
                                            "Action": [
                                                "cloudwatch:GetMetricData",
                                                "cloudwatch:GetMetricStatistics",
                                                "cloudwatch:ListMetrics"
                                            ],
                                            "Resource": "*"
                                        },
                                        {
                                            "Sid": "AiLogGroupAccess",
                                            "Effect": "Allow",
                                            "Action": [
                                                "logs:DescribeLogGroups",
                                                "logs:DescribeLogStreams",
                                                "logs:StartQuery",
                                                "logs:GetQueryResults",
                                                "logs:FilterLogEvents"
                                            ],
                                            "Resource": [
                                                "arn:aws:logs:*:*:log-group:/aws/bedrock/*",
                                                "arn:aws:logs:*:*:log-group:/aws/sagemaker/*",
                                                "arn:aws:logs:*:*:log-group:*ai*",
                                                "arn:aws:logs:*:*:log-group:*llm*"
                                            ]
                                        },
                                        {
                                            "Sid": "AiCostExplorer",
                                            "Effect": "Allow",
                                            "Action": [
                                                "ce:GetCostAndUsage",
                                                "ce:GetCostForecast"
                                            ],
                                            "Resource": "*"
                                        },
                                        {
                                            "Sid": "AiResourceDiscovery",
                                            "Effect": "Allow",
                                            "Action": [
                                                "tag:GetResources",
                                                "resource-groups:ListGroups"
                                            ],
                                            "Resource": "*"
                                        }
                                    ]
                                }
                            },
                            { "Ref": "AWS::NoValue" }
                        ]
                    }
                ]
            }
        },
        "LogForwarderRole": {
            "Type": "AWS::IAM::Role",
            "Condition": "LogForwardingEnabled",
            "Properties": {
                "RoleName": "RabbittizeLogForwarderRole",
                "AssumeRolePolicyDocument": {
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": { "Service": "lambda.amazonaws.com" },
                            "Action": "sts:AssumeRole"
                        }
                    ]
                },
                "ManagedPolicyArns": [
                    "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
                ],
                "Policies": [
                    {
                        "PolicyName": "RabbittizeLogForwarderPolicy",
                        "PolicyDocument": {
                            "Version": "2012-10-17",
                            "Statement": [
                                {
                                    "Effect": "Allow",
                                    "Action": [
                                        "logs:GetLogEvents",
                                        "logs:FilterLogEvents"
                                    ],
                                    "Resource": [
                                        "arn:aws:logs:*:*:log-group:/aws/bedrock/*",
                                        "arn:aws:logs:*:*:log-group:/aws/sagemaker/*"
                                    ]
                                }
                            ]
                        }
                    }
                ]
            }
        },
        "LogForwarderFunction": {
            "Type": "AWS::Lambda::Function",
            "Condition": "LogForwardingEnabled",
            "DependsOn": "LogForwarderRole",
            "Properties": {
                "FunctionName": "RabbittizeAiLogForwarder",
                "Runtime": "nodejs20.x",
                "Handler": "index.handler",
                "Role": { "Fn::GetAtt": ["LogForwarderRole", "Arn"] },
                "Timeout": 30,
                "MemorySize": 128,
                "Environment": {
                    "Variables": {
                        "RABBITTIZE_WEBHOOK_URL": { "Ref": "RabbittizeWebhookUrl" },
                        "RABBITTIZE_WORKSPACE_ID": { "Ref": "RabbittizeWorkspaceID" },
                        "RABBITTIZE_EXTERNAL_ID": { "Ref": "RabbittizeExternalID" }
                    }
                },
                "Code": {
                    "ZipFile": "const https = require('https'); const url = require('url'); exports.handler = async (event) => { const payload = JSON.stringify({ source: 'cloudwatch-forwarder', workspaceId: process.env.RABBITTIZE_WORKSPACE_ID, externalId: process.env.RABBITTIZE_EXTERNAL_ID, timestamp: new Date().toISOString(), logEvents: (event.awslogs ? Buffer.from(event.awslogs.data, 'base64').toString('utf8') : JSON.stringify(event)) }); const parsed = url.parse(process.env.RABBITTIZE_WEBHOOK_URL); const options = { hostname: parsed.hostname, port: 443, path: parsed.path, method: 'POST', headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload), 'X-Rabbittize-Source': 'log-forwarder' } }; return new Promise((resolve, reject) => { const req = https.request(options, (res) => { let body = ''; res.on('data', (d) => body += d); res.on('end', () => resolve({ statusCode: res.statusCode, body })); }); req.on('error', reject); req.write(payload); req.end(); }); };"
                }
            }
        },
        "LogForwarderPermission": {
            "Type": "AWS::Lambda::Permission",
            "Condition": "LogForwardingEnabled",
            "Properties": {
                "FunctionName": { "Ref": "LogForwarderFunction" },
                "Action": "lambda:InvokeFunction",
                "Principal": "logs.amazonaws.com",
                "SourceAccount": { "Ref": "AWS::AccountId" }
            }
        },
        "CostandUsageReportBucket": {
            "Type": "AWS::S3::Bucket",
            "DependsOn": "CrossAccountRole",
            "Properties": {
                "BucketName": {
                    "Ref": "BucketName"
                },
                "AccessControl": "Private",
                "PublicAccessBlockConfiguration": {
                    "BlockPublicAcls": true,
                    "BlockPublicPolicy": true,
                    "IgnorePublicAcls": true,
                    "RestrictPublicBuckets": true
                },
                "LifecycleConfiguration": {
                    "Rules": [
                        {
                            "Id": "ExpireOldObjects",
                            "Status": "Enabled",
                            "ExpirationInDays": 200
                        }
                    ]
                },
                "NotificationConfiguration": {
                    "TopicConfigurations": [
                        {
                            "Fn::If": [
                                "HasNotificationTopic",
                                {
                                    "Topic": {
                                        "Ref": "RabbittizeNotificationTopicArn"
                                    },
                                    "Event": "s3:ObjectCreated:*",
                                    "Filter": {
                                        "S3Key": {
                                            "Rules": [
                                                {
                                                    "Name": "suffix",
                                                    "Value": ".gz"
                                                }
                                            ]
                                        }
                                    }
                                },
                                {
                                    "Ref": "AWS::NoValue"
                                }
                            ]
                        }
                    ]
                }
            }
        },
        "CostandUsageReportBucketPolicy": {
            "Type": "AWS::S3::BucketPolicy",
            "DependsOn": "CostandUsageReportBucket",
            "Properties": {
                "Bucket": {
                    "Ref": "CostandUsageReportBucket"
                },
                "PolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Action": [
                                "s3:GetBucketAcl",
                                "s3:GetBucketPolicy"
                            ],
                            "Effect": "Allow",
                            "Resource": {
                                "Fn::Sub": "arn:aws:s3:::${CostandUsageReportBucket}"
                            },
                            "Principal": {
                                "Service": "billingreports.amazonaws.com"
                            }
                        },
                        {
                            "Action": [
                                "s3:PutObject"
                            ],
                            "Effect": "Allow",
                            "Resource": {
                                "Fn::Sub": "arn:aws:s3:::${CostandUsageReportBucket}/*"
                            },
                            "Principal": {
                                "Service": "billingreports.amazonaws.com"
                            }
                        },
                        {
                            "Action": [
                                "s3:GetObject",
                                "s3:GetObjectAcl"
                            ],
                            "Effect": "Allow",
                            "Resource": {
                                "Fn::Sub": "arn:aws:s3:::${CostandUsageReportBucket}/*"
                            },
                            "Principal": {
                                "AWS": {
                                    "Fn::GetAtt": [
                                        "CrossAccountRole",
                                        "Arn"
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        "CostandUsageReport": {
            "Type": "AWS::CUR::ReportDefinition",
            "DependsOn": "CostandUsageReportBucketPolicy",
            "Properties": {
                "AdditionalArtifacts": [],
                "AdditionalSchemaElements": [
                    "RESOURCES"
                ],
                "Compression": "GZIP",
                "Format": "textORcsv",
                "RefreshClosedReports": true,
                "ReportName": {
                    "Ref": "ReportName"
                },
                "ReportVersioning": "OVERWRITE_REPORT",
                "S3Bucket": {
                    "Ref": "CostandUsageReportBucket"
                },
                "S3Prefix": {
                    "Fn::FindInMap": [
                        "TimeUnitMap",
                        {
                            "Ref": "TimeUnit"
                        },
                        "S3Prefix"
                    ]
                },
                "S3Region": "us-east-1",
                "TimeUnit": {
                    "Ref": "TimeUnit"
                }
            }
        },
        "RabbittizePingResource": {
            "Type": "Custom::RabbittizePingResource",
            "DeletionPolicy": "Retain",
            "Properties": {
                "ServiceToken": {
                    "Ref": "RabbittizePingbackArn"
                },
                "RoleArn": {
                    "Fn::GetAtt": [
                        "CrossAccountRole",
                        "Arn"
                    ]
                },
                "BucketArn": {
                    "Fn::GetAtt": [
                        "CostandUsageReportBucket",
                        "Arn"
                    ]
                },
                "RabbittizeWorkspaceID": {
                    "Ref": "RabbittizeWorkspaceID"
                },
                "RabbittizeExternalID": {
                    "Ref": "RabbittizeExternalID"
                },
                "RabbittizeDomain": {
                    "Ref": "RabbittizeDomain"
                }
            }
        }
    },
    "Outputs": {
        "RoleArn": {
            "Value": {
                "Fn::GetAtt": [
                    "CrossAccountRole",
                    "Arn"
                ]
            },
            "Description": "The ARN of the Rabbittize Cross-Account Role."
        },
        "BucketName": {
            "Value": {
                "Ref": "CostandUsageReportBucket"
            },
            "Description": "The name of the CUR S3 bucket."
        },
        "AiObservabilityEnabled": {
            "Value": { "Ref": "EnableAiObservability" },
            "Description": "Whether AI Observability permissions are enabled."
        },
        "LogForwardingEnabled": {
            "Value": { "Ref": "EnableLogForwarding" },
            "Description": "Whether AI log forwarding Lambda is deployed."
        },
        "LogForwarderArn": {
            "Condition": "LogForwardingEnabled",
            "Value": { "Fn::GetAtt": ["LogForwarderFunction", "Arn"] },
            "Description": "ARN of the log forwarder Lambda function."
        }
    }
}
