NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# Server-side API rewrite target. Keep browser calls at /api/* in production.
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_TEMPLATE_URL=https://rabbittize-cf-templates.s3.us-east-1.amazonaws.com/rabbittize-aws-integration.json

# Optional explicit app environment override: development | production
# If omitted, NODE_ENV is used.
NEXT_PUBLIC_APP_ENV=development

# GitHub OAuth client IDs by environment
# Development uses *_DEVELOPMENT first, then falls back to NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID
# Production uses *_PRODUCTION first, then falls back to NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID_DEVELOPMENT=
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID_PRODUCTION=
