{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudcam.fonder.tech/schemas/report.schema.json",
  "title": "CloudWatcher Skill Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "system_type", "skill_name", "skill_version", "timestamp", "test_results", "raw_summary"],
  "properties": {
    "agent_id": { "type": "string", "minLength": 1 },
    "agent_name": { "type": "string", "minLength": 1 },
    "system_type": { "type": "string", "enum": ["raw-llm-api", "rag-pipeline", "agent-tools", "chatbot"] },
    "skill_name": { "type": "string", "minLength": 1 },
    "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "model": { "type": "string" },
        "environment": { "type": "string" },
        "repository": { "type": "string" },
        "evidence": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "files_inspected": { "type": "array", "items": { "type": "string" } },
            "ai_surface_areas": { "type": "array", "items": { "type": "string" } },
            "model_call_sites": { "type": "array", "items": { "type": "string" } },
            "retrieval_paths": { "type": "array", "items": { "type": "string" } },
            "tool_paths": { "type": "array", "items": { "type": "string" } },
            "chat_or_memory_paths": { "type": "array", "items": { "type": "string" } },
            "test_or_eval_paths": { "type": "array", "items": { "type": "string" } },
            "deployment_paths": { "type": "array", "items": { "type": "string" } },
            "existing_harness": { "type": "array", "items": { "type": "string" } },
            "harness_gaps": { "type": "array", "items": { "type": "string" } },
            "harness_audit": {
              "type": "object",
              "additionalProperties": { "type": "string", "enum": ["present", "partial", "missing", "not_applicable"] }
            }
          }
        }
      }
    },
    "audit_report": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "markdown_path": { "type": "string" },
        "executive_summary": { "type": "string" },
        "gap_analysis": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "recommended_modules": { "type": "array", "items": { "type": "string" } },
        "data_models": { "type": "array", "items": { "type": "string" } },
        "roadmap": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "backlog": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "open_questions": { "type": "array", "items": { "type": "string" } },
        "final_recommendations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scoring_inputs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "critical_gaps": { "type": "array", "items": { "type": "string" } },
        "score_caps": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "do_not_build_yet": { "type": "array", "items": { "type": "string" } },
        "evidence_confidence": { "type": "string", "enum": ["high", "medium", "low"] }
      }
    },
    "test_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "test_name", "input", "output", "pass_fail", "notes"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "test_name": { "type": "string", "minLength": 1 },
          "input": { "type": ["string", "object", "array"] },
          "output": { "type": ["string", "object", "array", "null"] },
          "pass_fail": { "type": "string", "enum": ["pass", "fail", "manual_review", "not_run"] },
          "notes": { "type": "string" },
          "latency_ms": { "type": "number", "minimum": 0 },
          "cost_usd": { "type": "number", "minimum": 0 },
          "citations": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "tool_calls": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source_type", "location", "claim", "excerpt", "reliability"],
                  "properties": {
                    "source_type": { "type": "string", "enum": ["source_file", "test", "runtime_trace", "log", "config", "command", "manual_inspection"] },
                    "location": { "type": "string", "minLength": 1 },
                    "claim": { "type": "string", "minLength": 1 },
                    "excerpt": { "type": "string", "minLength": 1 },
                    "reliability": { "type": "string", "enum": ["high", "medium", "low"] }
                  }
                }
              },
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "required": ["method", "outcome", "environment"],
                "properties": { "method": { "type": "string", "minLength": 1 }, "outcome": { "type": "string", "minLength": 1 }, "environment": { "type": "string", "minLength": 1 }, "commands": { "type": "array", "items": { "type": "string" } } }
              },
              "risk": {
                "type": "object",
                "additionalProperties": false,
                "required": ["severity", "likelihood", "impact", "affected_surface"],
                "properties": { "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] }, "likelihood": { "type": "string", "minLength": 1 }, "impact": { "type": "string", "minLength": 1 }, "affected_surface": { "type": "string", "minLength": 1 } }
              },
              "remediation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["recommended_action", "validation"],
                "properties": { "recommended_action": { "type": "string", "minLength": 1 }, "validation": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    },
    "raw_summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
  }
}
