# ═══════════════════════════════════════════════════
# Rabbittize Backend — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════

# ─── Server ───
PORT=4000
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:4000
NODE_ENV=development

# ─── Database ───
MONGODB_URI=mongodb://localhost:27017/rabbittize

# ─── Auth ───
JWT_SECRET=CHANGE-THIS-TO-A-STRONG-RANDOM-SECRET

# ─── Gemini AI ───
GEMINI_API_KEY=

# ─── AWS Master Account (STS AssumeRole) ───
AWS_REGION=ap-south-1
RABBITTIZE_MASTER_REGION=us-east-1
RABBITTIZE_MASTER_ACCESS_KEY_ID=
RABBITTIZE_MASTER_SECRET_ACCESS_KEY=

# ─── Azure App Registration (Optional Default Configuration) ───
AZURE_DEFAULT_REGION=centralindia
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
AZURE_TEMPLATE_URL=http://localhost:4000/api/azure/template
AZURE_WEBHOOK_URL=http://localhost:4000/api/azure/save-connection
AZURE_WEBHOOK_SECRET=CHANGE-THIS-TO-A-STRONG-WEBHOOK-SECRET
GCP_WEBHOOK_URL=http://localhost:4000/api/gcp/save-connection

# ─── Rabbittize CloudFormation ───
RABBITTIZE_TRUST_ROLE_ARN=767397861361
RABBITTIZE_PINGBACK_ARN=arn:aws:sns:us-east-1:767397861361:rabbittize-customer-pingbacks
NEXT_PUBLIC_TEMPLATE_URL=https://rabbittize-cf-templates.s3.us-east-1.amazonaws.com/rabbittize-aws-integration.json
RABBITTIZE_API_SECRET=
RABBITTIZE_WEBHOOK_URL=
RABBITTIZE_WEBHOOK_SECRET=CHANGE-THIS-TO-A-STRONG-WEBHOOK-SECRET

# ─── AI Observability Feature Flags ───
AI_OBSERVABILITY_ENABLED=true
BEDROCK_MONITORING_ENABLED=true
AI_CRON_ENABLED=true
LOG_FORWARDER_SECRET=CHANGE-THIS-TO-A-STRONG-FORWARDER-SECRET

# ─── AI Observability Notification Channels ───
AI_OBS_EMAIL_WEBHOOK=
AI_OBS_SLACK_WEBHOOK=
AI_OBS_GENERIC_WEBHOOK=
AI_OBS_WEBHOOK_SECRET=

# ─── Deployment Configuration ───
APP_ENV=development
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FARGATE_REGION=eu-north-1
FARGATE_CLUSTER=rabbittize-simulations
FARGATE_TASK_DEFINITION=rabbittize-terraform-runner
# GCP runner uses a dedicated task definition (Alpine + gcloud, ~127 MB).
# Defaults to FARGATE_TASK_DEFINITION + "-gcp" if not set.
FARGATE_GCP_TASK_DEFINITION=rabbittize-terraform-runner-gcp
FARGATE_CONTAINER_NAME=terraform-runner
FARGATE_LOG_GROUP=/ecs/rabbittize-terraform-runner
FARGATE_LOG_STREAM_PREFIX=ecs
FARGATE_ARTIFACT_BUCKET=rabbittize-fargate-artifacts-767397861361-eu-north-1
# Separate S3 bucket for GCP Fargate runner artifacts. Falls back to FARGATE_ARTIFACT_BUCKET if not set.
FARGATE_GCP_ARTIFACT_BUCKET=rabbittize-staging-artifacts-gcp
FARGATE_ARTIFACT_PREFIX=terraform-runs
FARGATE_SUBNETS=subnet-0252ac31a39faf29b,subnet-0ffc1e4648da3a4ea
FARGATE_SECURITY_GROUPS=sg-09aa39a5bc7013798
FARGATE_ASSIGN_PUBLIC_IP=true
# Set to "true" in staging/dev to route terraform runner containers through ECS Fargate.
# Use RUNNER_USE_FARGATE=true (not SIMULATION_USE_ECS) to avoid accidentally enabling
# the ECS session orchestrator which requires extra SIMULATION_SUBNET_ID vars.
RUNNER_USE_FARGATE=false
# Only set SIMULATION_USE_ECS=true if you have a dedicated ECS simulation task def
# and have set SIMULATION_SUBNET_ID + SIMULATION_SECURITY_GROUP_ID below.
SIMULATION_USE_ECS=false

# ─── OAuth Providers ───
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID_DEVELOPMENT=
GITHUB_OAUTH_CLIENT_SECRET_DEVELOPMENT=
GITHUB_OAUTH_CLIENT_ID_PRODUCTION=
GITHUB_OAUTH_CLIENT_SECRET_PRODUCTION=

# ─── Action Engine ───
ACTION_MODE=simulation

# ─── Email (SMTP) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@rabbittize.com
